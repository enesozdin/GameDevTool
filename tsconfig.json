{
  // Node tooling: build scripts and tests. App sources have their own configs
  // (src/core/tsconfig.json, src/tsconfig.json).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["build/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
